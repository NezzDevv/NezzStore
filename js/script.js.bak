  let cart = [];
  let currentSection = "minuman";
  let currentProduct = null;
  let currentVariant = "";
  let currentQty = 1;
  let currentSugar = "Normal";

  // Render badge HTML
  function badgeHTML(product) {
    if (!product.badge) return '';
    const cls = product.badge === 'best-seller' ? 'best-seller' : 'signature';
    const label = product.badge === 'best-seller' ? 'BEST SELLER' : 'SIGNATURE';
    return `<span class="card-tag ${cls}">${label}</span>`;
  }

  // Render menu items
  function renderMenu(filter = '') {
    const q = (filter || '').toLowerCase().trim();
    const allSections = ['minuman', 'makanan'];
    const container = document.getElementById(currentSection);
    if (!container) return;

    // WiFi section
    if (currentSection === 'wifi') {
      container.innerHTML = renderWifiSection();
      return;
    }
    // Info section
    if (currentSection === 'info') {
      container.innerHTML = renderInfoSection();
      return;
    }
    // Booking section
    if (currentSection === 'booking') {
      container.innerHTML = renderBookingSection();
      return;
    }
    // About section
    if (currentSection === 'about') {
      container.innerHTML = renderAboutSection();
      return;
    }

    // Product sections (minuman, bundle, makanan)
    let products;
    let usingGlobalSearch = q.length > 0;

    if (usingGlobalSearch) {
      products = [];
      // Search in minuman and makanan sections (and bundle for global search)
      ['minuman', 'makanan', 'bundle'].forEach(sec => {
        (menuData[sec] || []).forEach(p => {
          if (p.name.toLowerCase().includes(q)) {
            products.push({ ...p, _section: sec, _idx: menuData[sec].indexOf(p) });
          }
        });
      });
    } else {
      products = (menuData[currentSection] || []).map((p, i) => ({ ...p, _section: currentSection, _idx: i }));
    }

    if (usingGlobalSearch && products.length === 0) {
      container.innerHTML = `<div class="search-empty">🔍 Tidak ada menu yang cocok dengan "<strong>${escapeHtml(filter)}</strong>"</div>`;
      return;
    }

    // Check if bundle section — use bundle cards
    if (currentSection === 'bundle') {
      let html = '<div class="menu-grid">';
      html += products.map(p => {
        const origPrice = p.originalPrice ? `<span class="bundle-original">Rp ${p.originalPrice.toLocaleString('id-ID')}</span>` : '';
        const saveTag = p.originalPrice ? `<span class="bundle-save-tag">Hemat Rp ${(p.originalPrice - p.price).toLocaleString('id-ID')}</span>` : '';
        return `
          <div class="bundle-card" onclick="openProductDetail(${p._idx}, '${p._section}', ${p.id})">
            ${badgeHTML(p)}
            <div class="bundle-img-wrapper">
              ${saveTag}
              <img class="bundle-img" src="${p.image}" alt="${p.name}" loading="lazy" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22300%22><rect fill=%22%23fbf5ec%22 width=%22400%22 height=%22300%22/><text fill=%22%235d4037%22 font-size=%2214%22 x=%2250%%22 y=%2250%%22 text-anchor=%22middle%22>${encodeURIComponent(p.name)}</text></svg>'">
            </div>
            <div class="bundle-info">
              <div class="bundle-name">${p.name}</div>
              <div class="bundle-items">${p.items.map(i => '✓ ' + i).join('<br>')}</div>
              <div class="bundle-price-wrap">
                <div class="bundle-prices">
                  ${origPrice}
                  <span class="bundle-current">Rp ${p.price.toLocaleString('id-ID')}</span>
                </div>
                <button class="bundle-add-btn" onclick="event.stopPropagation();quickAdd(${p.id}, '${p._section}')">+ Tambah</button>
              </div>
            </div>
          </div>
        `;
      }).join('');
      html += '</div>';
      container.innerHTML = html;
      return;
    }

    // Regular product cards (minuman, makanan)
    let html = '<div class="menu-grid">';
    html += products.map(p => `
      <div class="menu-card" onclick="openProductDetail(${p._idx}, '${p._section}', ${p.id})">
        ${badgeHTML(p)}
        <div class="menu-card-wrapper">
          <img src="${p.image}" alt="${p.name}" loading="lazy" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22300%22><rect fill=%22%23fbf5ec%22 width=%22400%22 height=%22300%22/><text fill=%22%235d4037%22 font-size=%2214%22 x=%2250%%22 y=%2250%%22 text-anchor=%22middle%22>${encodeURIComponent(p.name)}</text></svg>'">
        </div>
        <div class="menu-card-info">
          <div class="menu-name">${p.name}</div>
          <div class="menu-price">Rp ${p.price.toLocaleString('id-ID')}</div>
        </div>
        <button class="menu-add-btn" onclick="event.stopPropagation();quickAdd(${p.id}, '${p._section}')" aria-label="Tambah ${p.name}">+</button>
      </div>
    `).join('') + '</div>';

    container.innerHTML = html;
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // WiFi section content
  function renderWifiSection() {
    return `
      <div class="menu-grid">
        <div class="info-grid" style="grid-template-columns:1fr;">
          <div class="wifi-card">
            <div class="wifi-tier">
              <div class="wifi-tier-name">WiFi Premium — Rp 5.000 / 2 Jam</div>
              <div class="wifi-ssid"><b>SSID:</b> WarNezzel Premium</div>
              <div class="wifi-pass"><b>Password:</b> WarNezzelPremium</div>
              <div style="margin-top:6px;">
                <button class="wifi-copy-btn" onclick="copyWifi('WarNezzelPremium')">Salin Password</button>
              </div>
            </div>
            <div class="wifi-tier">
              <div class="wifi-tier-name">WiFi Standar — Gratis</div>
              <div class="wifi-ssid"><b>SSID:</b> WarNezzel Guest</div>
              <div class="wifi-pass"><b>Password:</b> WarNezzelGuest2026</div>
              <div style="margin-top:6px;">
                <button class="wifi-copy-btn" onclick="copyWifi('WarNezzelGuest2026')">Salin Password</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    `;
  }

  function copyWifi(text) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => showToast('Password disalin!'));
    }
  }

  // Info section content
  function renderInfoSection() {
    return `
      <div class="info-grid">
        <div class="info-card">
          <div class="info-card-icon">📍</div>
          <h3 class="info-card-title">Lokasi WarNezzel</h3>
          <p class="info-card-body">Jl. Kopi Nusantara No. 42, Jakarta Selatan — tepat di depan Taman Bunga, sebelah Indomaret.</p>
          <a class="info-card-action" href="https://www.google.com/maps?sca_esv=05e9b9d0eac2d55a&sxsrf=APpeQntdVCoun3YRMWTQC9bIc6RK1OxOjA:1783537230075&um=1&ie=UTF-8&fb=1&gl=id&sa=X&geocode=KVGcm8A7H2ouMUbHbDq8xZxw&daddr=Jl.+Cemara+No.36,+RT.14/RW.7,+Sunter+Agung,+Kec.+Tj.+Priok,+Jkt+Utara,+Daerah+Khusus+Ibukota+Jakarta+14350" target="_blank" rel="noopener">Buka di Google Maps →</a>
        </div>
        <div class="info-card">
          <div class="info-card-icon">🕐</div>
          <h3 class="info-card-title">Jam Operasional</h3>
          <p class="info-card-body">
            <b>Senin – Jumat:</b> 10.00 – 22.00 WIB<br>
            <b>Sabtu – Minggu:</b> 09.00 – 23.00 WIB<br>
            <b>Hari Libur Nasional:</b> 10.00 – 20.00 WIB
          </p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">🎉</div>
          <h3 class="info-card-title">Promo Terbaru</h3>
          <p class="info-card-body">
            <b>Happy Hour:</b> 3x2 untuk semua Good Day Series (14.00–16.00)<br>
            <b>Minggu Tanpa Kopi:</b> Diskon 20% semua espresso (tiap Selasa)<br>
            <b>Paket Meja 4:</b> Hemat 10K untuk rombongan 4 orang!
          </p>
          <a class="info-card-action" href="https://wa.me/6289684943741?text=Halo%2C%20ada%20promo%20baru%3F" target="_blank" rel="noopener">Tanya Promo Lainnya →</a>
        </div>
      </div>
    `;
  }

  // Booking section content
  function renderBookingSection() {
    return `
      <div class="booking-card">
        <h3 class="section-title" style="margin-bottom:18px;">🪑 Reservasi Meja</h3>
        <p style="font-size:12.5px;color:var(--text-muted);line-height:1.6;margin-bottom:16px;text-align:center;">
          Pesan meja favoritmu untuk nongkrong, meeting, atau acara spesial. Kami akan konfirmasi via WhatsApp.
        </p>
        <label>Nama Lengkap</label>
        <input type="text" id="bookName" placeholder="Nama kamu...">
        <div class="booking-grid-2">
          <div>
            <label>Tanggal</label>
            <input type="date" id="bookDate">
          </div>
          <div>
            <label>Waktu</label>
            <input type="time" id="bookTime">
          </div>
        </div>
        <div class="booking-grid-2">
          <div>
            <label>Jumlah Orang</label>
            <select id="bookPeople">
              <option value="1">1 orang</option>
              <option value="2" selected>2 orang</option>
              <option value="3">3 orang</option>
              <option value="4">4 orang</option>
              <option value="5">5 orang</option>
              <option value="6">6 orang</option>
              <option value="7">7–10 orang</option>
              <option value="11">10+ orang (grup)</option>
            </select>
          </div>
          <div>
            <label>Jenis Meja</label>
            <select id="bookTable">
              <option value="outdoor" selected>Outdoor (Teras)</option>
              <option value="indoor">Indoor (AC)</option>
              <option value="vip">VIP Room</option>
            </select>
          </div>
        </div>
        <label>Catatan Tambahan (opsional)</label>
        <textarea id="bookNotes" placeholder="Ada permintaan khusus? Misalnya: ulang tahun, meeting, dll."></textarea>
        <button class="booking-submit-btn" onclick="submitBooking()">Kirim Reservasi via WhatsApp</button>
      </div>
    `;
  }

  function submitBooking() {
    const name = document.getElementById('bookName').value.trim();
    const date = document.getElementById('bookDate').value;
    const time = document.getElementById('bookTime').value;
    const people = document.getElementById('bookPeople');
    const peopleText = people.options[people.selectedIndex].text;
    const table = document.getElementById('bookTable');
    const tableText = table.options[table.selectedIndex].text;
    const notes = document.getElementById('bookNotes').value.trim();

    if (!name || !date || !time) {
      showToast('Nama, tanggal, dan waktu wajib diisi!', true);
      return;
    }

    const waPhone = '6289684943741';
    const msg = `*Reservasi Meja WarNezzel*%0A%0A` +
      `Nama: ${encodeURIComponent(name)}%0A` +
      `Tanggal: ${encodeURIComponent(date)}%0A` +
      `Waktu: ${encodeURIComponent(time)}%0A` +
      `Penumpang: ${encodeURIComponent(peopleText)}%0A` +
      `Jenis Meja: ${encodeURIComponent(tableText)}%0A` +
      `Catatan: ${notes ? encodeURIComponent(notes) : '-'}`;

    window.open(`https://wa.me/${waPhone}?text=${msg}`, '_blank');
    showToast('Reservasi dikirim ke WhatsApp!');
  }

  // About section content
  function renderAboutSection() {
    return `
      <div class="about-card">
        <h4>Cerita Kami</h4>
        <p>WarNezzel lahir dari kecintaan kami terhadap kopi Nusantara dan budaya ngopi yang mengakar kuat. Nama <b>"Nezzel"</b> terinspirasi dari semangat lokal — rasa kopi yang khas, hangat, dan selalu bikin nagih. Di WarNezzel, kami percaya bahwa secangkir kopi yang baik punya kekuatan menyatukan orang-orang.</p>
      </div>
      <div class="about-card">
        <h4>Visi</h4>
        <p>Menjadi destinasi ngopi #1 yang menghadirkan pengalaman kopi terbaik dari seluruh pelosok Indonesia — dipadukan dengan camilan rumahan yang bikin betah berlama-lama.</p>
      </div>
      <div class="about-card">
        <h4>Misi</h4>
        <p><b>1.</b> Menyajikan minuman berkualitas tinggi dengan bahan lokal pilihan.<br>
           <b>2.</b> Menciptakan ruang nyaman untuk berkumpul, bekerja, dan bersantai.<br>
           <b>3.</b> Mendukung petani kopi lokal dengan sourcing etis.<br>
           <b>4.</b> Terus berinovasi dalam menu — dari klasik hingga modern.<br>
           <b>5.</b> Memberikan pelayanan ramah dan personal kepada setiap pelanggan.</p>
      </div>
    `;
  }

  // Open WiFi section
  function openWifiSection() {
    currentSection = 'wifi';
    document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.section').forEach(sec => sec.style.display = 'none');
    const sec = document.getElementById('wifi');
    if (sec) {
      sec.style.display = 'block';
      sec.style.animation = 'fadeInUp 0.5s var(--ease-smooth)';
      renderMenu();
    }
    // Scroll ke bagian WiFi
    sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Quick add: buka product detail modal
  function quickAdd(id, section) {
    let product = null, idx = 0;
    ['minuman', 'bundle', 'makanan'].forEach(sec => {
      if (product) return;
      const arr = menuData[sec];
      if (arr) {
        product = arr.find(p => p.id === id);
        idx = product ? arr.indexOf(product) : 0;
      }
    });
    if (!product) return;
    openProductDetail(idx, section, id);
  }

  // Section tabs
  document.querySelectorAll('.tab-btn').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentSection = tab.dataset.section;
      document.querySelectorAll('.section').forEach(sec => sec.style.display = 'none');
      const sec = document.getElementById(currentSection);
      if (sec) {
        sec.style.display = 'block';
        sec.style.animation = 'fadeInUp 0.5s var(--ease-smooth)';
        renderMenu(document.getElementById('searchInput').value.trim());
      }
    });
  });

  // Search functionality
  function handleSearch(value) {
    const wrap = document.getElementById('kategoriSearch');
    if (wrap) wrap.classList.toggle('has-value', value.length > 0);
    renderMenu(value.trim());
  }

  function clearSearch() {
    const input = document.getElementById('searchInput');
    input.value = '';
    handleSearch('');
    input.focus();
  }

  // Product detail modal
  function openProductDetail(idx, section, id) {
    let product = null;
    if (menuData[section]) {
      product = menuData[section].find(p => p.id === id);
    }
    if (!product) {
      ['minuman', 'bundle', 'makanan'].forEach(sec => {
        if (product) return;
        if (menuData[sec]) {
          product = menuData[sec].find(p => p.id === id);
        }
      });
    }
    if (!product) return;

    currentProduct = product;
    currentVariant = product.variants[0];
    currentSugar = "Normal";
    currentQty = 1;

    document.getElementById('pdImage').src = product.image;
    document.getElementById('pdTitle').textContent = product.name;
    let descHTML = product.description;
    if (product.items && product.items.length) {
      descHTML += '<br><br><b style="color:var(--gold);">Isi Paket:</b><br>' + product.items.join('<br>');
    }
    document.getElementById('pdDesc').innerHTML = descHTML;

    let priceText = 'Rp ' + product.price.toLocaleString('id-ID');
    if (product.originalPrice) {
      priceText = `<s style="color:var(--text-muted);font-weight:500;font-size:14px;">Rp ${product.originalPrice.toLocaleString('id-ID')}</s> &nbsp;Rp ${product.price.toLocaleString('id-ID')}`;
    }
    document.getElementById('pdPrice').innerHTML = priceText;

    document.getElementById('pdVariant').innerHTML = product.variants.map((v, i) =>
      `<label><input type="radio" name="variant" value="${v}" ${i===0?'checked':''}> ${v}</label>`
    ).join('');

    // Sugar row hanya untuk minuman
    const sugarRow = document.getElementById('pdSugar');
    if (product.sugar) {
      sugarRow.innerHTML = `
        <div class="pd-section-label">Tingkat Gula</div>
        <div class="pd-sugar-options">
          <label><input type="radio" name="sugar" value="Less Sugar"> <span>Less Sugar</span></label>
          <label><input type="radio" name="sugar" value="Normal" checked> <span>Normal</span></label>
          <label><input type="radio" name="sugar" value="Extra Sugar"> <span>Extra Sugar</span></label>
        </div>
      `;
      sugarRow.style.display = 'block';
    } else {
      sugarRow.innerHTML = '';
      sugarRow.style.display = 'none';
    }

    document.getElementById('productDetailOverlay').classList.add('open');
  }

  function closeProductDetail() {
    document.getElementById('productDetailOverlay').classList.remove('open');
  }

  // Variant & sugar selection
  document.addEventListener('change', (e) => {
    if (e.target.name === 'variant' && currentProduct) {
      currentVariant = e.target.value;
    }
    if (e.target.name === 'sugar' && currentProduct) {
      currentSugar = e.target.value;
    }
  });

  // Add to cart dari product detail: tambah item, tutup modal, TAPI jangan auto buka cart
  // (user bisa pesan menu lain dulu, klik FAB cart kapan saja untuk checkout)
  document.getElementById('pdAddBtn').addEventListener('click', () => {
    if (!currentProduct) return;
    // Tentukan sugar untuk item ini (jika bukan minuman, default "Normal")
    const sugar = currentProduct.sugar ? currentSugar : "Normal";
    // Item dianggap sama jika id + variant + sugar sama
    const existingIdx = cart.findIndex(item =>
      item.id === currentProduct.id &&
      item.variant === currentVariant &&
      item.sugar === sugar
    );
    if (existingIdx >= 0) {
      cart[existingIdx].qty += currentQty;
      cart[existingIdx].subtotal = cart[existingIdx].price * cart[existingIdx].qty;
    } else {
      cart.push({
        ...currentProduct,
        variant: currentVariant,
        sugar,
        qty: currentQty,
        subtotal: currentProduct.price * currentQty
      });
    }
    updateCartBadge();
    closeProductDetail();
    showToast('Ditambahkan ke keranjang');
    // Pulse + ripple wave animation pada tombol header
    const headerBtn = document.querySelector('.header-cart-btn');
    if (headerBtn) {
      headerBtn.classList.remove('pulse');
      void headerBtn.offsetWidth;
      headerBtn.classList.add('pulse');
      setTimeout(() => headerBtn.classList.remove('pulse'), 600);

      // Tambah ripple ring
      const ring = document.createElement('span');
      ring.className = 'ripple-ring';
      headerBtn.appendChild(ring);
      setTimeout(() => ring.remove(), 700);
    }
  });

  // Cart badge
  function updateCartBadge() {
    const count = cart.reduce((sum, item) => sum + item.qty, 0);
    const badge = document.getElementById('headerCartCount');
    if (badge) {
      badge.textContent = count;
      badge.style.display = count > 0 ? 'inline-flex' : 'none';
    }
  }

  // Show order form inside cart
  function viewCart() {
    const cartOverlay = document.getElementById('cartOverlay');
    const backdrop = document.getElementById('cartBackdrop');
    cartOverlay.classList.add('open');
    backdrop.classList.add('visible');
    document.body.style.overflow = 'hidden';

    const cartListEl = document.getElementById('cartItemList');
    const totalEl = document.getElementById('cartTotal');

    if (cart.length === 0) {
      cartListEl.innerHTML = '<div class="cart-empty">&#129392;<br>Keranjang masih kosong</div>';
      totalEl.textContent = 'Rp 0';
    } else {
      let html = '';
      cart.forEach((item, i) => {
        const subtotal = item.price * item.qty;
        const sugarTag = item.sugar && item.sugar !== 'Normal'
          ? ` &bull; <span class="cart-sugar-tag">${item.sugar}</span>`
          : '';
        html += `
          <div class="cart-item-row">
            <div class="cart-item-info">
              <div class="cart-item-name">${item.name}</div>
              <div class="cart-item-variant">${item.variant}${sugarTag} &bull; x${item.qty}</div>
              <div class="cart-item-sub">Rp ${item.price.toLocaleString('id-ID')} x ${item.qty} = Rp ${subtotal.toLocaleString('id-ID')}</div>
            </div>
            <button class="cart-remove-btn" onclick="removeCartItem(${i})">&times;</button>
          </div>
        `;
      });
      cartListEl.innerHTML = html;
      const total = cart.reduce((t, i) => t + (i.subtotal || (i.price * i.qty)), 0);
      totalEl.textContent = 'Rp ' + total.toLocaleString('id-ID');
    }
  }

  function closeCart() {
    const cartOverlay = document.getElementById('cartOverlay');
    const backdrop = document.getElementById('cartBackdrop');
    cartOverlay.classList.remove('open');
    backdrop.classList.remove('visible');
    document.body.style.overflow = '';
  }

  function removeCartItem(index) {
    cart.splice(index, 1);
    updateCartBadge();
    viewCart(); // refresh
  }

  // WhatsApp order
  function orderViaWhatsApp() {
    const customerName = document.getElementById('miniCustomerName').value.trim();
    const tableNumber = document.getElementById('miniTableNumber').value.trim();

    if (!customerName || !tableNumber) {
      showToast('Nama & nomor meja wajib diisi!', true);
      return;
    }

    const waPhone = '6289684943741';
    let msg = `*Order by: ${customerName}*\n`;
    msg += `*Meja: ${tableNumber}*\n\n`;
    msg += `*Pesanan WarNezzel*:\n\n`;

    let total = 0;
    cart.forEach((item, i) => {
      const subtotal = item.price * item.qty;
      total += subtotal;
      msg += `${i + 1}. ${item.name}\n`;
      msg += `   Varian: ${item.variant}\n`;
      if (item.sugar && item.sugar !== 'Normal') {
        msg += `   Gula: ${item.sugar}\n`;
      }
      if (item.items && item.items.length) {
        msg += `   Isi: ${item.items.join(', ')}\n`;
      }
      msg += `   Qty: ${item.qty}\n`;
      msg += `   Rp ${subtotal.toLocaleString('id-ID')}\n\n`;
    });

    msg += `*Total: Rp ${total.toLocaleString('id-ID')}*\n\nTerima kasih!`;
    window.open(`https://wa.me/${waPhone}?text=${encodeURIComponent(msg)}`, '_blank');

    // Clear cart after sending
    cart = [];
    updateCartBadge();
    closeCart();
  }

  // Quantity controls
  function changeQty(delta) {
    currentQty = Math.max(1, Math.min(99, currentQty + delta));
    document.getElementById('qtyDisplay').textContent = currentQty;
  }

  // Toast notification
  let toastTimeout;
  function showToast(msg = 'Ditambahkan ke keranjang!', isError = false) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.remove('success', 'error');
    if (isError) {
      toast.classList.add('error');
      toast.style.background = 'linear-gradient(135deg, #e74c3c, #c0392b)';
      toast.style.color = '#fff';
    } else {
      toast.classList.add('success');
      toast.style.background = '';
      toast.style.color = '';
    }
    toast.classList.add('show');
    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => toast.classList.remove('show'), 2200);
  }

  // Banner slider — class switching dengan dot indicators & manual controls
  let bannerTimer = null;
  function startBannerSlider() {
    const slides = document.querySelectorAll('.banner-slide');
    const dotsContainer = document.getElementById('bannerDots');
    if (!slides.length) return;

    // Build dot indicators
    if (dotsContainer) {
      dotsContainer.innerHTML = '';
      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.className = 'dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('aria-label', 'Slide ' + (i + 1));
        dot.onclick = (e) => {
          e.stopPropagation();
          goToBannerSlide(i);
        };
        dotsContainer.appendChild(dot);
      });
    }

    // Swipe support untuk mobile
    const hero = document.getElementById('bannerSlider');
    if (hero) {
      let startX = 0;
      let startY = 0;
      hero.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      }, { passive: true });
      hero.addEventListener('touchend', (e) => {
        const endX = e.changedTouches[0].clientX;
        const endY = e.changedTouches[0].clientY;
        const dx = endX - startX;
        const dy = endY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          changeBannerSlide(dx < 0 ? 1 : -1);
        }
      }, { passive: true });

      // Pause auto-play saat hover, resume saat keluar (sehingga user bisa baca banner dengan tenang)
      hero.addEventListener('mouseenter', stopBannerAutoPlay);
      hero.addEventListener('mouseleave', startBannerAutoPlay);
    }

    startBannerAutoPlay();
  }

  function startBannerAutoPlay() {
    stopBannerAutoPlay();
    // Reset progress bar
    const progress = document.getElementById('bannerProgress');
    if (progress) {
      progress.classList.remove('running');
      void progress.offsetWidth; // force reflow untuk restart animation
      progress.classList.add('running');
    }
    bannerTimer = setInterval(() => changeBannerSlide(1), 5000);
  }

  function stopBannerAutoPlay() {
    if (bannerTimer) {
      clearInterval(bannerTimer);
      bannerTimer = null;
    }
    const progress = document.getElementById('bannerProgress');
    if (progress) progress.classList.remove('running');
  }

  function changeBannerSlide(delta) {
    const slides = document.querySelectorAll('.banner-slide');
    if (!slides.length) return;
    const currentIdx = Array.from(slides).findIndex(s => s.classList.contains('active'));
    const nextIdx = (currentIdx + delta + slides.length) % slides.length;
    goToBannerSlide(nextIdx);
    startBannerAutoPlay(); // reset timer
  }

  function goToBannerSlide(idx) {
    const slides = document.querySelectorAll('.banner-slide');
    const dots = document.querySelectorAll('.banner-dots .dot');
    if (!slides.length || idx < 0 || idx >= slides.length) return;

    // Animate out current slide (cinematic zoom-out)
    const current = document.querySelector('.banner-slide.active');
    if (current) {
      current.classList.add('exiting');
      setTimeout(() => current.classList.remove('exiting'), 900);
    }

    // Reset content-card animation pada slide baru (supaya slideUpFade replay)
    slides.forEach(s => {
      s.classList.remove('active');
      const card = s.querySelector('.banner-content-card');
      if (card) {
        card.style.animation = 'none';
        void card.offsetWidth;
        card.style.animation = '';
      }
    });
    dots.forEach(d => d.classList.remove('active'));

    // Activate new slide (timing bertepatan dengan exit animation)
    setTimeout(() => {
      slides[idx].classList.add('active');
      if (dots[idx]) dots[idx].classList.add('active');
    }, 80);
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    renderMenu();
    startBannerSlider();
    updateCartBadge();
  });

