  * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, sans-serif; }

  :root {
    --bg-primary: #ffffff;
    --bg-secondary: #faf6f1;
    --bg-card: #fff9f2;
    --bg-accent: #f5ede4;
    --brown-deep: #3e2723;
    --brown-medium: #5d4037;
    --brown-light: #8d6e63;
    --brown-pale: #d7ccc8;
    --cream: #fefcf9;
    --gold: #c8944e;
    --gold-light: #e8b96e;
    --gold-dark: #a07830;
    --text-primary: #2c1810;
    --text-secondary: #6d4c41;
    --text-muted: #a1887f;
    --accent: #c62828;
    --accent-green: #2e7d32;
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
    --ease-out: cubic-bezier(0, 0, 0.2, 1);
    --shadow-sm: 0 2px 8px rgba(62, 39, 35, 0.06);
    --shadow-md: 0 4px 16px rgba(62, 39, 35, 0.1);
    --shadow-lg: 0 8px 32px rgba(62, 39, 35, 0.14);
    --shadow-xl: 0 16px 48px rgba(62, 39, 35, 0.18);
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  /* ===== RICH STATIC BACKGROUND (no animation — warna stabil) ===== */
  body {
    min-height: 100vh;
    min-height: 100dvh;
    color: var(--text-primary);
    padding-bottom: 140px;
    overflow-x: hidden;
    overflow-y: auto;
    position: relative;
    background: #faf6f1;
  }

  /* Layer 1: Soft warm gradient canvas — light theme */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 50% at 20% 0%, rgba(232, 185, 110, 0.12) 0%, transparent 55%),
      radial-gradient(ellipse 70% 60% at 85% 100%, rgba(141, 110, 99, 0.08) 0%, transparent 55%),
      radial-gradient(ellipse 60% 40% at 50% 50%, rgba(255, 255, 255, 0.6) 0%, transparent 60%),
      linear-gradient(180deg, #ffffff 0%, #faf6f1 50%, #f5ede4 100%);
  }
  /* Subtle decorative pattern - coffee bean inspired */
  .bg-beans {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.4;
  }
  .bg-beans .bean {
    position: absolute;
    width: 12px;
    height: 18px;
    background: linear-gradient(135deg, #d7ccc8, #a1887f);
    border-radius: 50% / 60%;
    opacity: 0.1;
    transform: rotate(var(--rot, 25deg));
  }
  .bg-beans .bean::after {
    content: '';
    position: absolute;
    width: 1px;
    height: 60%;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(93, 64, 55, 0.6);
    border-radius: 2px;
  }
  .bg-beans .bean-1 { top: 8%; left: 5%; --rot: 35deg; }
  .bg-beans .bean-2 { top: 22%; left: 88%; --rot: -20deg; }
  .bg-beans .bean-3 { top: 45%; left: 95%; --rot: 60deg; }
  .bg-beans .bean-4 { top: 68%; left: 3%; --rot: -45deg; }
  .bg-beans .bean-5 { top: 82%; left: 75%; --rot: 15deg; }
  .bg-beans .bean-6 { top: 92%; left: 35%; --rot: -55deg; }

  /* Ensure all content sits above background layers */
  .header, .banner-section, .kategori-tabs, .section, .cart-fab, .modal-overlay, .toast {
    position: relative;
    z-index: 1;
  }

  /* ===== ANIMATION KEYFRAMES ===== */
  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  @keyframes badgePop {
    0% { transform: scale(0); }
    60% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }
  @keyframes ripple {
    0% { transform: scale(0); opacity: 0.6; }
    100% { transform: scale(4); opacity: 0; }
  }
  @keyframes glowPulse {
    0%, 100% { box-shadow: 0 4px 15px rgba(245, 200, 118, 0.3); }
    50% { box-shadow: 0 4px 25px rgba(245, 200, 118, 0.6); }
  }
  @keyframes bannerFloat {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-4px) scale(1.01); }
  }
  @keyframes toastSlideUp {
    0% { opacity: 0; transform: translateX(-50%) translateY(30px) scale(0.9); }
    15% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1.02); }
    25% { transform: translateX(-50%) translateY(0) scale(1); }
    75% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
    100% { opacity: 0; transform: translateX(-50%) translateY(20px) scale(0.95); }
  }
  @keyframes cartBounce {
    0% { transform: rotate(0deg); }
    20% { transform: rotate(-15deg); }
    40% { transform: rotate(15deg); }
    60% { transform: rotate(-8deg); }
    80% { transform: rotate(8deg); }
    100% { transform: rotate(0deg); }
  }

  /* ===== HEADER ===== */
  .header {
    background: linear-gradient(180deg, rgba(46,26,15,0.98) 0%, rgba(30,18,8,0.95) 100%);
    backdrop-filter: blur(40px) saturate(1.8);
    -webkit-backdrop-filter: blur(40px) saturate(1.8);
    padding: 8px 16px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: 56px;
    box-shadow: 0 6px 28px rgba(0,0,0,0.55), 0 2px 0 rgba(245, 200, 118, 0.08);
    animation: fadeInDown 0.6s var(--ease-smooth);
    border-bottom: 1px solid rgba(245, 200, 118, 0.18);
  }

  /* ===== HEADER ROTATOR — center stack (logo + brand + subtitle) ===== */
  /* Logo + brand + subtitle ditumpuk vertikal di tengah, semua terlihat bareng */
  .header-rotator {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-height: 42px;
    min-width: 0;
    align-self: stretch;
    text-align: center;
  }
  .header-rotator-logo,
  .header-rotator-brand,
  .header-rotator-subtitle {
    position: relative;
    top: auto;
    left: auto;
    margin: 0;
    padding: 0;
    opacity: 1;
    transform: none;
    white-space: nowrap;
    will-change: opacity, transform;
  }

  /* Logo: glow breathing (selalu terlihat). Brand: shimmer halus. Subtitle: statis. */
  .header-rotator-logo     { animation: logoGlow 6s ease-in-out infinite; }
  .header-rotator-brand    { animation: brandShimmer 6s ease-in-out infinite; }
  /* .header-rotator-subtitle: statis, tidak ada animasi */

  /* Logo: rounded badge dengan glow breathing */
  .header-rotator-logo {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid rgba(245, 200, 118, 0.7);
    background: #fff;
    padding: 2px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.45),
                0 0 0 2px rgba(245, 200, 118, 0.08),
                0 0 28px rgba(245, 200, 118, 0.3);
    object-fit: cover;
    transition: box-shadow 0.4s ease;
  }
  @keyframes logoGlow {
    0%, 100% { box-shadow: 0 6px 24px rgba(0,0,0,0.45), 0 0 0 3px rgba(245, 200, 118, 0.08), 0 0 35px rgba(245, 200, 118, 0.3); }
    50%      { box-shadow: 0 6px 24px rgba(0,0,0,0.45), 0 0 0 4px rgba(245, 200, 118, 0.18), 0 0 50px rgba(245, 200, 118, 0.55); }
  }
  .header-rotator-logo:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.55),
                0 0 0 4px rgba(245, 200, 118, 0.2),
                0 0 60px rgba(245, 200, 118, 0.6);
  }

  /* Brand: gradient gold text dengan shimmer sweep */
  .header-rotator-brand {
    position: relative;
    font-family: 'Georgia', 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    text-shadow: 0 0 14px rgba(245, 200, 118, 0.45), 0 1px 2px rgba(0,0,0,0.3);
    background: linear-gradient(135deg, var(--gold-dim) 0%, var(--gold) 30%, #fff5dc 50%, var(--gold) 70%, var(--gold-dim) 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  @keyframes brandShimmer {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }
  /* Decorative gold flourishes di kiri-kanan brand */
  .header-rotator-brand::before,
  .header-rotator-brand::after {
    content: '✦';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold);
    font-size: 9px;
    -webkit-text-fill-color: var(--gold);
    opacity: 0.7;
    text-shadow: 0 0 8px rgba(245, 200, 118, 0.6);
  }
  .header-rotator-brand::before { left: -14px; }
  .header-rotator-brand::after  { right: -14px; }

  /* Subtitle: small caption dengan tagline accent */
  .header-rotator-subtitle {
    position: relative;
    font-family: 'Georgia', 'Playfair Display', serif;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(245, 200, 118, 0.85);
    text-shadow: 0 0 10px rgba(245, 200, 118, 0.35);
    padding: 0 8px;
  }
  /* Tiny line di kiri-kanan subtitle */
  .header-rotator-subtitle::before,
  .header-rotator-subtitle::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 8px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245, 200, 118, 0.6), transparent);
  }
  .header-rotator-subtitle::before { left: -4px; }
  .header-rotator-subtitle::after  { right: -4px; }
  .header-cart-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 11px 22px;
    background: linear-gradient(135deg, rgba(245, 200, 118, 0.18) 0%, rgba(245, 200, 118, 0.08) 100%);
    color: var(--gold);
    border: 1px solid rgba(245, 200, 118, 0.35);
    border-radius: 26px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(12px) saturate(1.3);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 245, 220, 0.08);
    transition: all 0.35s var(--ease-spring);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
    margin-left: auto;
    align-self: center;
    min-height: 44px;
  }
  /* Cart icon: optical center alignment dengan teks */
  .header-cart-icon {
    font-size: 17px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transform: translateY(-0.5px);
    filter: drop-shadow(0 1px 1px rgba(0,0,0,0.35));
  }
  /* (::before & ::after reserved untuk hover gradient + shimmer) */
  .header-cart-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--gold) 0%, #e0b366 100%);
    opacity: 0;
    transition: opacity 0.35s;
    z-index: -1;
  }
  .header-cart-btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transform: translateY(-50%);
    transition: left 0.6s var(--ease-smooth);
  }
  .header-cart-btn:hover::before { opacity: 1; }
  .header-cart-btn:hover::after { left: 100%; }
  .header-cart-btn:hover {
    color: var(--bg-dark);
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(245, 200, 118, 0.45), 0 0 0 1px rgba(245, 200, 118, 0.4);
  }
  .header-cart-btn:active { transform: translateY(-1px) scale(0.97); }

  /* WiFi button next to cart in header */
  .header-wifi-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 16px;
    background: linear-gradient(135deg, rgba(74, 144, 226, 0.2), rgba(53, 122, 189, 0.1));
    color: #8ab8f0;
    border: 1px solid rgba(74, 144, 226, 0.35);
    border-radius: 26px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(12px) saturate(1.3);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: all 0.35s var(--ease-spring);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
    margin-left: 8px;
    align-self: center;
    min-height: 44px;
    font-family: inherit;
  }
  .header-wifi-btn:hover {
    background: linear-gradient(135deg, rgba(74, 144, 226, 0.3), rgba(53, 122, 189, 0.18));
    color: #b0d0f8;
    border-color: rgba(74, 144, 226, 0.55);
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(74, 144, 226, 0.25), 0 0 0 1px rgba(74, 144, 226, 0.3);
  }
  .header-wifi-btn:active { transform: translateY(0) scale(0.97); }
  .header-wifi-icon { font-size: 16px; line-height: 1; display: inline-flex; align-items: center; justify-content: center; transform: translateY(-0.5px); filter: drop-shadow(0 1px 1px rgba(0,0,0,0.35)); }
  .header-wifi-label { display: inline; }

  /* Ripple wave animation on cart button */
  .header-cart-btn .ripple-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border-radius: 22px;
    border: 2px solid var(--gold);
    animation: cartRipple 0.6s var(--ease-out) forwards;
    pointer-events: none;
  }
  @keyframes cartRipple {
    0% { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }
    100% { transform: translate(-50%, -50%) scale(1.6); opacity: 0; }
  }
  .header-cart-count {
    display: none;
    background: linear-gradient(135deg, var(--accent), #a93226);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    min-width: 22px;
    height: 22px;
    border-radius: 11px;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    box-shadow: 0 3px 10px rgba(231, 76, 60, 0.5), inset 0 1px 0 rgba(255,255,255,0.2);
    margin-left: 2px;
    border: 1.5px solid rgba(46, 26, 15, 0.7);
  }

  /* ===== BANNER HERO ===== */
  .banner-section {
    padding: 16px;
    animation: fadeInUp 0.6s var(--ease-smooth) 0.3s both;
  }
  .banner-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.9;
  }
  .banner-label::before,
  .banner-label::after {
    content: '';
    flex: 0 0 30px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold));
  }
  .banner-label::after {
    background: linear-gradient(90deg, var(--gold), transparent);
  }

  .banner-hero {
    width: 100%;
    max-width: 1200px;
    aspect-ratio: 16 / 9;
    max-height: 45vh;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    box-shadow:
      0 14px 44px rgba(0,0,0,0.55),
      0 0 0 1px rgba(245, 200, 118, 0.12),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    transition: transform 0.4s var(--ease-spring), box-shadow 0.4s var(--ease-smooth);
    margin: 0 auto;
    touch-action: pan-y;
  }
  .banner-hero:active { transform: scale(0.985); transition-duration: 0.12s; }
  .banner-hero:hover {
    box-shadow:
      0 18px 55px rgba(245, 200, 118, 0.22),
      0 0 0 1px rgba(245, 200, 118, 0.25),
      0 0 50px rgba(245, 200, 118, 0.12);
  }

  /* Decorative gold corner brackets */
  .banner-hero::before,
  .banner-hero::after {
    content: '';
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2px solid rgba(245, 200, 118, 0.7);
    z-index: 4;
    pointer-events: none;
    filter: drop-shadow(0 0 4px rgba(245, 200, 118, 0.5));
    transition: border-color 0.3s;
  }
  .banner-hero::before {
    top: 10px; left: 10px;
    border-right: none;
    border-bottom: none;
    border-top-left-radius: 6px;
  }
  .banner-hero::after {
    bottom: 10px; right: 10px;
    border-left: none;
    border-top: none;
    border-bottom-right-radius: 6px;
  }
  .banner-hero:hover::before,
  .banner-hero:hover::after {
    border-color: var(--gold);
  }

  /* Banner progress bar timing indicator (di atas) */
  .banner-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 2.5px;
    width: 0%;
    background: linear-gradient(90deg, var(--gold), #ffd98e, var(--gold));
    background-size: 200% 100%;
    z-index: 5;
    box-shadow: 0 0 8px rgba(245, 200, 118, 0.7), 0 1px 0 rgba(0,0,0,0.4);
  }
  .banner-progress.running {
    animation: bannerProgressFill 5s linear forwards, bannerProgressShine 2s linear infinite;
  }
  @keyframes bannerProgressFill {
    from { width: 0%; }
    to   { width: 100%; }
  }
  @keyframes bannerProgressShine {
    0%   { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }
  .banner-slides {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .banner-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1);
    transition: opacity 0.8s ease-in-out;
  }
  .banner-slide:not(.active):not(.exiting) .banner-slide-img {
    transform: scale(1);
  }
  .banner-slide.active {
    opacity: 1;
    z-index: 1;
  }

  /* Cinematic zoom-out saat slide akan berganti (class ditambahkan via JS) */
  .banner-slide.exiting {
    opacity: 0;
    z-index: 0;
  }

  .banner-slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.85) saturate(1.1);
    transform: scale(1.05);
  }
  /* Slow Ken Burns zoom-in saja, TANPA drift — foto tetap diam (hanya zoom pelan) */
  .banner-slide.active .banner-slide-img {
    animation: bannerStaticZoom 14s ease-out forwards;
  }
  @keyframes bannerStaticZoom {
    from { transform: scale(1.05); }
    to   { transform: scale(1.1); }
  }

  .banner-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(to top, rgba(15, 8, 4, 0.98) 0%, rgba(20, 10, 5, 0.7) 30%, rgba(20, 10, 5, 0.15) 65%, transparent 100%),
      radial-gradient(ellipse at top right, transparent 55%, rgba(20, 10, 5, 0.35) 100%),
      linear-gradient(135deg, rgba(245, 200, 118, 0.04) 0%, transparent 50%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    padding: 16px;
    pointer-events: none;
  }

  /* Floating gold particles dalam banner */
  .banner-particles {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }
  .banner-particle {
    position: absolute;
    background: var(--gold);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(245, 200, 118, 0.6);
    opacity: 0;
  }
  .banner-particle.bp-1 {
    width: 4px; height: 4px;
    top: 20%; left: 15%;
    animation: bannerParticleFloat 6s ease-in-out infinite;
  }
  .banner-particle.bp-2 {
    width: 3px; height: 3px;
    top: 35%; left: 78%;
    animation: bannerParticleFloat 8s ease-in-out infinite 1s;
  }
  .banner-particle.bp-3 {
    width: 5px; height: 5px;
    top: 60%; left: 8%;
    animation: bannerParticleFloat 7s ease-in-out infinite 2s;
  }
  .banner-particle.bp-4 {
    width: 3px; height: 3px;
    top: 75%; left: 65%;
    animation: bannerParticleFloat 9s ease-in-out infinite 3s;
  }
  .banner-particle.bp-5 {
    width: 4px; height: 4px;
    top: 50%; left: 45%;
    animation: bannerParticleFloat 10s ease-in-out infinite 4s;
  }
  @keyframes bannerParticleFloat {
    0%   { transform: translate(0, 0) scale(0); opacity: 0; }
    15%  { opacity: 0.7; transform: translate(8px, -10px) scale(1); }
    50%  { opacity: 0.9; transform: translate(-6px, -30px) scale(1.2); }
    85%  { opacity: 0.4; transform: translate(4px, -50px) scale(0.8); }
    100% { transform: translate(0, -70px) scale(0); opacity: 0; }
  }

  .banner-content-card {
    background: linear-gradient(180deg, rgba(46, 26, 15, 0.55) 0%, rgba(26, 15, 8, 0.75) 100%);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid rgba(245, 200, 118, 0.22);
    border-radius: 16px;
    padding: 16px 18px;
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(245, 200, 118, 0.15);
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
    overflow: hidden;
    animation: slideUpFade 0.6s var(--ease-smooth) 0.2s both;
  }
  /* Sweep shimmer line di dalam card */
  .banner-content-card::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(245, 200, 118, 0.1), transparent);
    animation: cardShimmerSweep 4s ease-in-out infinite;
  }
  @keyframes cardShimmerSweep {
    0%   { left: -60%; }
    50%  { left: 120%; }
    100% { left: 120%; }
  }
  @keyframes slideUpFade {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .banner-hero-badge {
    align-self: flex-start;
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    padding: 5px 14px;
    border-radius: 14px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
    box-shadow:
      0 4px 14px rgba(245, 200, 118, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    animation: pulse 2.5s ease-in-out infinite;
    margin-bottom: 2px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    position: relative;
    z-index: 1;
  }
  /* Sparkle di samping badge */
  .banner-hero-badge::after {
    content: '✦';
    font-size: 11px;
    color: var(--bg-dark);
    opacity: 0.7;
  }

  .banner-hero-title {
    font-size: clamp(20px, 4.2vw, 32px);
    font-weight: 800;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.9);
    letter-spacing: 0.3px;
    line-height: 1.15;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .banner-hero-desc {
    font-size: clamp(13px, 2.4vw, 15px);
    color: rgba(245, 230, 211, 0.92);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.7);
    line-height: 1.4;
    margin: 0;
    font-weight: 500;
    position: relative;
    z-index: 1;
  }

  /* CTA button dalam banner */
  .banner-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    padding: 8px 16px;
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    border: none;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    cursor: pointer;
    align-self: flex-start;
    box-shadow:
      0 4px 14px rgba(245, 200, 118, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    transition: all 0.3s var(--ease-spring);
    position: relative;
    z-index: 1;
    pointer-events: auto;
    font-family: inherit;
  }
  .banner-cta:hover {
    transform: translateX(3px);
    box-shadow:
      0 6px 20px rgba(245, 200, 118, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .banner-cta-arrow {
    transition: transform 0.3s var(--ease-spring);
    display: inline-block;
  }
  .banner-cta:hover .banner-cta-arrow {
    transform: translateX(3px);
  }

  /* Slide indicators (dots) */
  .banner-dots {
    position: absolute;
    bottom: 14px;
    right: 18px;
    z-index: 3;
    display: flex;
    gap: 7px;
    pointer-events: auto;
  }
  .banner-dots .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(245, 200, 118, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: all 0.35s var(--ease-spring);
    padding: 0;
  }
  .banner-dots .dot:hover {
    background: rgba(245, 200, 118, 0.6);
    transform: scale(1.2);
  }
  .banner-dots .dot.active {
    width: 26px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--gold), #e0b366);
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 0 0 10px rgba(245, 200, 118, 0.5);
  }

  /* Navigation arrows */
  .banner-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(46, 26, 15, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(245, 200, 118, 0.25);
    color: var(--gold);
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s var(--ease-spring);
    opacity: 0;
    pointer-events: none;
  }
  .banner-hero:hover .banner-arrow,
  .banner-hero:active .banner-arrow {
    opacity: 1;
    pointer-events: auto;
  }
  .banner-arrow:hover {
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 6px 18px rgba(245, 200, 118, 0.4);
  }
  .banner-arrow:active { transform: translateY(-50%) scale(0.92); }
  .banner-arrow.prev { left: 12px; }
  .banner-arrow.next { right: 12px; }

  @media (max-width: 480px) {
    .banner-hero {
      aspect-ratio: 4 / 3;
      border-radius: 16px;
    }
    .banner-arrow { display: none; }
    .banner-content-card { padding: 12px 14px; border-radius: 14px; }
    .banner-dots { bottom: 10px; right: 14px; }
  }

  /* ===== TABS ===== */
  .kategori-tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    position: sticky;
    top: 76px;
    z-index: 40;
    background: linear-gradient(180deg, rgba(46,26,15,0.96) 0%, rgba(46,26,15,0.85) 100%);
    backdrop-filter: blur(40px) saturate(1.3);
    -webkit-backdrop-filter: blur(40px) saturate(1.3);
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    border-bottom: 1px solid rgba(245, 200, 118, 0.08);
    animation: fadeInUp 0.6s var(--ease-smooth) 0.4s both;
    padding: 14px 16px;
  }
  .kategori-tabs .tabs-group {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 0 1 auto;
    min-width: 0;
    justify-content: center;
    padding: 4px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(245, 200, 118, 0.08);
    border-radius: 30px;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(245, 200, 118, 0.04);
    max-width: 100%;
  }
  .kategori-tabs .tabs-group::-webkit-scrollbar { display: none; }
  .kategori-search {
    position: relative;
    flex: 0 0 auto;
    flex-shrink: 0;
  }
  .kategori-search input {
    width: 160px;
    max-width: 36vw;
    padding: 10px 36px 10px 38px;
    border-radius: 22px;
    border: 1px solid rgba(245, 200, 118, 0.18);
    background: rgba(0,0,0,0.35);
    color: var(--text);
    font-size: 13px;
    outline: none;
    transition: all 0.3s var(--ease-smooth);
    font-family: inherit;
  }
  .kategori-search input::placeholder { color: var(--text-muted); opacity: 0.6; }
  .kategori-search input:focus {
    border-color: rgba(245, 200, 118, 0.5);
    background: rgba(0,0,0,0.55);
    box-shadow: 0 0 0 3px rgba(245, 200, 118, 0.1);
    width: 200px;
  }
  .kategori-search .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    color: var(--gold);
    pointer-events: none;
  }
  .kategori-search .search-clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: rgba(245, 200, 118, 0.15);
    color: var(--gold);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .kategori-search .search-clear:hover { background: rgba(245, 200, 118, 0.3); }
  .kategori-search.has-value .search-clear { display: flex; }
  .kategori-tabs::-webkit-scrollbar { display: none; }
  .tab-btn {
    flex: 0 0 auto;
    background: transparent;
    color: var(--text-muted);
    border: none;
    padding: 8px 18px;
    border-radius: 22px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.35s var(--ease-spring);
    white-space: nowrap;
    position: relative;
    letter-spacing: 0.4px;
    overflow: hidden;
  }
  .tab-btn:hover {
    color: var(--text);
  }
  .tab-btn.active {
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    box-shadow: 0 4px 14px rgba(245, 200, 118, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    font-weight: 700;
    animation: tabActiveGlow 2.5s ease-in-out infinite;
  }
  @keyframes tabActiveGlow {
    0%, 100% { box-shadow: 0 4px 14px rgba(245, 200, 118, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.2); }
    50%      { box-shadow: 0 4px 18px rgba(245, 200, 118, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 0 18px rgba(245, 200, 118, 0.3); }
  }
  .tab-btn.active:hover { color: var(--bg-dark); }

  /* ===== SECTION (improved) ===== */
  .section {
    padding: 22px 16px 110px;
    animation: fadeInUp 0.5s var(--ease-smooth) both;
    display: block;
  }
  .section[style*="none"] { display: none; }
  .section-title {
    font-size: 18px;
    font-weight: 800;
    color: var(--gold);
    margin: 0 auto 18px;
    padding: 0 24px 14px;
    text-align: center;
    letter-spacing: 0.8px;
    position: relative;
    text-shadow: 0 0 25px rgba(245, 200, 118, 0.2);
    display: block;
    width: fit-content;
  }
  /* Icon di kiri-kanan title */
  .section-title::before {
    content: '✦';
    position: absolute;
    left: 4px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold);
    font-size: 11px;
    text-shadow: 0 0 8px rgba(245, 200, 118, 0.7);
  }
  .section-title::after {
    content: '✦';
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold);
    font-size: 11px;
    text-shadow: 0 0 8px rgba(245, 200, 118, 0.7);
  }
  /* Underline gradient */
  .section-title {
    background-image: linear-gradient(90deg, transparent, rgba(245, 200, 118, 0.4) 30%, rgba(245, 200, 118, 0.4) 70%, transparent);
    background-repeat: no-repeat;
    background-size: 100% 1px;
    background-position: 0 100%;
  }

  /* ===== MENU GRID ===== */
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 14px;
    padding: 0 6px;
    max-width: 750px;
    margin: 0 auto;
  }
  .search-empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.6;
    position: relative;
  }
  .search-empty::before {
    content: '☕';
    display: block;
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.5;
    filter: drop-shadow(0 0 12px rgba(245, 200, 118, 0.3));
    animation: emptyFloat 3s ease-in-out infinite;
  }
  @keyframes emptyFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }
  .search-empty strong { color: var(--gold); }
  @media (min-width: 480px) {
    .menu-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
  @media (min-width: 768px) {
    .menu-grid { grid-template-columns: repeat(3, 1fr); gap: 16px; }
  }

  /* ===== MENU CARD - responsive grid ===== */
  .menu-card {
    background:
      linear-gradient(180deg, rgba(245, 200, 118, 0.04) 0%, rgba(93,54,33,0.85) 100%);
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
      0 4px 20px rgba(0,0,0,0.4),
      inset 0 1px 0 rgba(255,255,255,0.04);
    cursor: pointer;
    transition: all 0.4s var(--ease-spring);
    width: 100%;
    min-height: 160px;
    flex-shrink: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(245, 200, 118, 0.08);
    animation: fadeInUp 0.5s var(--ease-smooth) both;
  }
  .menu-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100%;
    background: linear-gradient(180deg, rgba(245, 200, 118, 0.05) 0%, transparent 30%, transparent 70%, rgba(0,0,0,0.3) 100%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
    z-index: 1;
  }
  .menu-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(245, 200, 118, 0.05) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
    z-index: 1;
  }
  .menu-card:hover::after { opacity: 1; }
  .menu-card:nth-child(1) { animation-delay: 0.05s; }
  .menu-card:nth-child(2) { animation-delay: 0.1s; }
  .menu-card:nth-child(3) { animation-delay: 0.15s; }
  .menu-card:nth-child(4) { animation-delay: 0.2s; }
  .menu-card:nth-child(5) { animation-delay: 0.25s; }
  .menu-card:nth-child(6) { animation-delay: 0.3s; }
  .menu-card:nth-child(7) { animation-delay: 0.35s; }
  .menu-card:nth-child(8) { animation-delay: 0.4s; }
  .menu-card:nth-child(9) { animation-delay: 0.45s; }
  .menu-card:nth-child(10) { animation-delay: 0.5s; }
  .menu-card:nth-child(11) { animation-delay: 0.55s; }
  .menu-card:nth-child(12) { animation-delay: 0.6s; }
  .menu-card:nth-child(13) { animation-delay: 0.65s; }
  .menu-card:nth-child(14) { animation-delay: 0.7s; }

  .menu-card:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow:
      0 16px 40px rgba(0,0,0,0.6),
      0 0 25px rgba(245, 200, 118, 0.12),
      inset 0 1px 0 rgba(255,255,255,0.08);
    border-color: rgba(245, 200, 118, 0.2);
  }
  .menu-card:hover::before { opacity: 1; }
  .menu-card:active {
    transform: scale(0.97);
    transition-duration: 0.1s;
  }

  /* Tag Badge on Card */
  .card-tag {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 12px;
    border-radius: 10px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.8px;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    animation: badgePop 0.5s var(--ease-spring) 0.5s both;
  }
  .card-tag.best-seller {
    background: linear-gradient(135deg, #ff6b35, #e74c3c);
    color: #fff;
  }
  .card-tag.signature {
    background: linear-gradient(135deg, var(--gold), #f0a500);
    color: var(--bg-dark);
  }

  .menu-card img {
    width: 100%;
    height: 130px;
    object-fit: cover;
    background: var(--bg-light);
    flex-shrink: 0;
    transition: transform 0.4s var(--ease-smooth);
  }
  .menu-card:hover img { transform: scale(1.03); }

  .menu-card-info {
    flex: 1;
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    z-index: 1;
    position: relative;
  }
  .menu-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.25s;
    letter-spacing: 0.2px;
  }
  .menu-card:hover .menu-name { color: #fff; }

  /* Price chip dengan gold accent line */
  .menu-price {
    position: relative;
    font-size: 14px;
    color: var(--gold);
    font-weight: 800;
    letter-spacing: 0.3px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px 2px 4px;
    border-radius: 8px;
    background: linear-gradient(90deg, rgba(245, 200, 118, 0.12) 0%, rgba(245, 200, 118, 0.04) 100%);
    transition: all 0.3s var(--ease-spring);
  }
  .menu-price::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 12px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--gold), #b8860b);
    box-shadow: 0 0 6px rgba(245, 200, 118, 0.5);
  }
  .menu-card:hover .menu-price {
    background: linear-gradient(90deg, rgba(245, 200, 118, 0.25) 0%, rgba(245, 200, 118, 0.1) 100%);
    color: #fff5dc;
  }

  /* "Best Seller" ribbon on cards (jika ada class .menu-bestseller) */
  .menu-bestseller-badge {
    position: absolute;
    top: 10px;
    left: -4px;
    z-index: 3;
    padding: 3px 10px 3px 8px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--bg-dark);
    background: linear-gradient(135deg, var(--gold), #ffd98e);
    border-radius: 0 10px 10px 0;
    box-shadow: 0 3px 10px rgba(245, 200, 118, 0.45), 2px 2px 0 rgba(0,0,0,0.2);
    text-shadow: 0 1px 0 rgba(255,255,255,0.3);
  }
  .menu-bestseller-badge::before {
    content: '★';
    margin-right: 3px;
    font-size: 10px;
  }
  .menu-bestseller-badge::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    border-style: solid;
    border-width: 4px 0 0 4px;
    border-color: #8a621a transparent transparent transparent;
  }

  /* Shimmer overlay on image loading */
  .menu-card img {
    background: linear-gradient(110deg, var(--bg-light) 8%, rgba(74, 46, 26, 0.6) 18%, var(--bg-light) 33%);
    background-size: 200% 100%;
    animation: shimmer 1.5s linear infinite;
  }

  .menu-add-btn {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    border: 2px solid rgba(255, 255, 255, 0.1);
    font-size: 22px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow:
      0 4px 14px rgba(245, 200, 118, 0.4),
      0 0 18px rgba(245, 200, 118, 0.08);
    transition: all 0.25s var(--ease-spring);
    z-index: 2;
  }
  .menu-add-btn:hover {
    transform: scale(1.15) rotate(90deg);
    box-shadow:
      0 6px 22px rgba(245, 200, 118, 0.6),
      0 0 30px rgba(245, 200, 118, 0.15);
  }
  .menu-add-btn:active {
    transform: scale(0.92);
    background: linear-gradient(135deg, #e0b366, #c9952e);
  }

  /* ===== MODAL ===== */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    z-index: 100;
    align-items: flex-end;
    justify-content: center;
  }
  .modal-overlay.show {
    display: flex;
    animation: fadeInUp 0.3s var(--ease-smooth);
  }
  .modal-overlay.show .modal-box {
    animation: modalSlideUp 0.4s var(--ease-spring);
  }
  @keyframes modalSlideUp {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .modal-overlay.hiding .modal-box {
    animation: modalSlideDown 0.3s var(--ease-out) forwards;
  }
  @keyframes modalSlideDown {
    from { transform: translateY(0); opacity: 1; }
    to { transform: translateY(100%); opacity: 0; }
  }
  .modal-box {
    background: linear-gradient(180deg, rgba(93,54,33,0.98) 0%, rgba(62,36,21,0.98) 100%);
    box-shadow: 0 -8px 40px rgba(0,0,0,0.5), 0 0 1px rgba(245, 200, 118, 0.2);
    width: 100%;
    max-width: 480px;
    max-height: 85vh;
    border-radius: 24px 24px 0 0;
    padding: 20px 22px 30px;
    overflow-y: auto;
    border-top: 1px solid rgba(245, 200, 118, 0.15);
    scrollbar-width: thin;
    scrollbar-color: rgba(245, 200, 118, 0.3) transparent;
  }
  .modal-handle {
    width: 40px;
    height: 4px;
    background: rgba(255,255,255,0.2);
    border-radius: 4px;
    margin: 0 auto 18px;
    transition: width 0.3s;
  }
  .modal-box:hover .modal-handle { width: 60px; background: rgba(245, 200, 118, 0.4); }
  .modal-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 16px;
    margin-bottom: 16px;
    background: var(--bg-light);
    box-shadow: 0 8px 25px rgba(0,0,0,0.4);
    transition: transform 0.3s var(--ease-spring);
  }
  .modal-img:hover { transform: scale(1.02); }
  .modal-title {
    font-size: 22px;
    font-weight: 800;
    color: var(--gold);
    margin-bottom: 6px;
    letter-spacing: 0.3px;
  }
  .modal-price {
    font-size: 19px;
    color: var(--text);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .modal-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 18px;
    padding: 10px 14px;
    background: rgba(0,0,0,0.2);
    border-radius: 12px;
    border-left: 3px solid var(--gold);
  }
  .modal-section-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 10px;
    margin-top: 14px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    opacity: 0.8;
  }

  /* Variant */
  .variant-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }
  .variant-item {
    background: var(--bg-light);
    padding: 12px 14px;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.25s var(--ease-smooth);
    font-size: 13px;
    color: var(--text);
    position: relative;
    overflow: hidden;
  }
  .variant-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(245,200,118,0.15) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .variant-item:hover::after { opacity: 1; }
  .variant-item:hover { transform: translateX(3px); }
  .variant-item.selected {
    border-color: var(--gold);
    background: rgba(245, 200, 118, 0.1);
    box-shadow: 0 0 15px rgba(245, 200, 118, 0.2);
  }
  .variant-item.selected::after { opacity: 1; }
  .variant-name { font-weight: 600; position: relative; z-index: 1; }
  .variant-item.selected .variant-name::after {
    content: ' ✓';
    color: var(--gold);
  }

  /* Qty Row */
  .qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-light);
    padding: 12px 16px;
    border-radius: 14px;
    margin-bottom: 18px;
    border: 1px solid rgba(245, 200, 118, 0.1);
  }
  .qty-label { font-size: 14px; color: var(--text); font-weight: 600; }
  .qty-control { display: flex; align-items: center; gap: 16px; }
  .qty-btn {
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 18px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s var(--ease-spring);
    box-shadow: 0 2px 8px rgba(245, 200, 118, 0.3);
  }
  .qty-btn:hover { transform: scale(1.15); box-shadow: 0 4px 12px rgba(245, 200, 118, 0.5); }
  .qty-btn:active { transform: scale(0.9); }
  .qty-num {
    font-size: 18px;
    font-weight: 800;
    color: var(--text);
    min-width: 32px;
    text-align: center;
    transition: transform 0.2s var(--ease-spring);
  }
  .qty-num.bump { animation: qtyBump 0.25s var(--ease-spring); }
  @keyframes qtyBump {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); color: var(--gold); }
    100% { transform: scale(1); }
  }

  /* Add to Cart Button */
  .add-btn {
    width: 100%;
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    border: none;
    padding: 16px;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.25s var(--ease-spring);
    box-shadow:
      0 4px 15px rgba(245, 200, 118, 0.35),
      0 0 30px rgba(245, 200, 118, 0.05);
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
  }
  .add-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.5s, height 0.5s;
  }
  .add-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 50%);
    pointer-events: none;
    border-radius: 14px;
  }
  .add-btn:active::before { width: 400px; height: 400px; }
  .add-btn:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 20px rgba(245, 200, 118, 0.5),
      0 0 40px rgba(245, 200, 118, 0.1);
  }
  .add-btn:active {
    transform: translateY(0) scale(0.98);
  }

  /* ===== FLOATING CART ===== */
  .cart-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    box-shadow:
      0 8px 30px rgba(0,0,0,0.5),
      0 0 40px rgba(245, 200, 118, 0.15);
    cursor: pointer;
    z-index: 90;
    border: 3px solid rgba(255, 255, 255, 0.15);
    transition: all 0.35s var(--ease-spring);
    animation: float 3s ease-in-out infinite, glowPulse 2s ease-in-out infinite;
  }
  .cart-fab:hover {
    transform: translateY(-6px) scale(1.12);
    box-shadow:
      0 16px 50px rgba(245, 200, 118, 0.4),
      0 0 70px rgba(245, 200, 118, 0.2);
  }
  .cart-fab:active { transform: scale(0.92); animation: none; }
  .cart-fab.ding { animation: cartBounce 0.5s var(--ease-spring); }
  .cart-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    display: none;
    background: linear-gradient(135deg, var(--accent), #c0392b);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    min-width: 22px;
    height: 22px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    padding: 0 5px;
    box-shadow: 0 2px 8px rgba(217, 83, 79, 0.5);
    border: 2px solid var(--gold);
    transition: transform 0.3s var(--ease-spring);
  }
  .cart-badge.pop { animation: badgePop 0.4s var(--ease-spring); }

  /* ===== TOAST ===== */
  .toast {
    position: fixed;
    bottom: 110px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, rgba(46, 26, 15, 0.95), rgba(26, 15, 8, 0.95));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: var(--gold);
    padding: 14px 28px;
    border-radius: 28px;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 8px 30px rgba(0,0,0,0.6), 0 0 25px rgba(245, 200, 118, 0.1);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    border: 1px solid rgba(245, 200, 118, 0.2);
    transition: all 0.3s var(--ease-smooth);
    letter-spacing: 0.3px;
    overflow: hidden;
  }
  /* Toast success variant */
  .toast.success {
    border-color: rgba(76, 175, 80, 0.4);
    box-shadow: 0 8px 30px rgba(0,0,0,0.6), 0 0 25px rgba(76, 175, 80, 0.2);
  }
  .toast.success::before {
    content: '✓';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4caf50, #2e7d32);
    color: #fff;
    font-size: 11px;
    margin-right: 8px;
    box-shadow: 0 0 8px rgba(76, 175, 80, 0.6);
  }
  /* Progress bar di bawah toast */
  .toast::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, var(--gold), #ffd98e);
    box-shadow: 0 0 6px rgba(245, 200, 118, 0.6);
  }
  .toast.show::after {
    animation: toastProgress 2.2s linear forwards;
  }
  @keyframes toastProgress {
    from { width: 0%; }
    to   { width: 100%; }
  }
  .toast.show {
    animation: toastSlideUp 2.2s var(--ease-smooth) forwards;
  }

  /* ===== SCROLLBAR ===== */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(245, 200, 118, 0.3); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: rgba(245, 200, 118, 0.5); }

  /* ===== CART OVERLAY ===== */
  .cart-overlay {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.85);
    width: 380px;
    max-width: 92vw;
    max-height: 85vh;
    background: linear-gradient(180deg, #2a1a0f 0%, #1a0f08 100%);
    border-radius: 22px;
    border: 1px solid rgba(245, 200, 118, 0.15);
    z-index: 500;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 80px rgba(0,0,0,0.8), 0 0 50px rgba(245, 200, 118, 0.1);
    opacity: 0;
    pointer-events: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }
  .cart-overlay.open {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
    pointer-events: auto;
  }
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 22px 14px;
    border-bottom: 1px solid rgba(245, 200, 118, 0.12);
  }
  .cart-header-title {
    font-size: 20px;
    font-weight: 800;
    color: var(--gold);
    letter-spacing: 0.5px;
  }
  .cart-close-btn {
    background: rgba(245, 200, 118, 0.1);
    border: 1px solid rgba(245, 200, 118, 0.15);
    color: var(--gold);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s;
  }
  .cart-close-btn:hover {
    background: rgba(245, 200, 118, 0.2);
    transform: rotate(90deg);
  }
  .cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 14px 22px;
  }
  .cart-empty {
    text-align: center;
    color: rgba(245, 200, 118, 0.45);
    font-size: 15px;
    padding: 50px 0;
    line-height: 1.7;
    letter-spacing: 0.3px;
  }
  .cart-item-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(245, 200, 118, 0.1);
    transition: background 0.2s;
    border-radius: 6px;
  }
  .cart-item-info {
    flex: 1;
    min-width: 0;
  }
  .cart-item-name {
    font-size: 15px;
    font-weight: 700;
    color: #f0e0c8;
    line-height: 1.3;
  }
  .cart-item-variant {
    font-size: 12px;
    color: rgba(245, 200, 118, 0.6);
    margin-top: 3px;
  }
  .cart-item-sub {
    font-size: 13px;
    color: rgba(240, 224, 200, 0.55);
    margin-top: 5px;
    font-weight: 600;
  }
  .cart-remove-btn {
    background: rgba(231, 76, 60, 0.1);
    border: 1px solid rgba(231, 76, 60, 0.25);
    color: #e74c3c;
    font-size: 18px;
    cursor: pointer;
    padding: 4px 8px;
    line-height: 1;
    border-radius: 8px;
    opacity: 0.75;
    transition: all 0.25s;
    flex-shrink: 0;
  }
  .cart-remove-btn:hover {
    opacity: 1;
    background: rgba(231, 76, 60, 0.2);
    transform: scale(1.05);
  }
  .cart-footer {
    border-top: 1px solid rgba(245, 200, 118, 0.12);
    padding: 16px 22px 24px;
    background: rgba(0, 0, 0, 0.15);
  }
  .cart-total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 18px;
    font-weight: 800;
    color: var(--gold);
    margin-bottom: 14px;
    padding: 14px 16px;
    background: linear-gradient(135deg, rgba(245, 200, 118, 0.12), rgba(245, 200, 118, 0.04));
    border-radius: 12px;
    border: 1px solid rgba(245, 200, 118, 0.2);
    box-shadow: inset 0 1px 0 rgba(245, 200, 118, 0.1);
    position: relative;
  }
  .cart-total-row::before {
    content: '';
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 24px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--gold), #b8860b);
    box-shadow: 0 0 8px rgba(245, 200, 118, 0.5);
  }
  .cart-total-row > * { position: relative; }
  .wa-order-btn {
    width: 100%;
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: #fff;
    border: none;
    padding: 16px;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.35), 0 0 25px rgba(37, 211, 102, 0.1);
    transition: all 0.25s var(--ease-spring);
    letter-spacing: 0.4px;
  }
  .wa-order-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(37, 211, 102, 0.5), 0 0 35px rgba(37, 211, 102, 0.15);
  }
  .wa-order-btn:active {
    transform: translateY(0) scale(0.98);
  }
  .clear-cart-btn {
    width: 100%;
    background: rgba(231, 76, 60, 0.12);
    color: #e74c3c;
    border: 1px solid rgba(231, 76, 60, 0.25);
    padding: 12px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 10px;
    transition: all 0.25s;
    letter-spacing: 0.3px;
  }
  .clear-cart-btn:hover {
    background: rgba(231, 76, 60, 0.2);
    transform: translateY(-1px);
  }
  .backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 499;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-smooth);
  }
  .backdrop.visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ORDER FORM (joined into cart footer) */
  .cart-form {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(245, 200, 118, 0.12);
    border-radius: 14px;
    padding: 14px 14px;
    margin-bottom: 16px;
  }
  .cart-form-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--gold);
    margin: 0 0 12px 0;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    opacity: 0.85;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cart-form input {
    width: 100%;
    padding: 11px 14px;
    border-radius: 10px;
    border: 1px solid rgba(245, 200, 118, 0.18);
    background: rgba(0, 0, 0, 0.4);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    outline: none;
    margin-bottom: 8px;
    box-sizing: border-box;
    font-family: inherit;
    transition: all 0.25s var(--ease-smooth);
  }
  .cart-form input:last-child { margin-bottom: 0; }
  .cart-form input::placeholder { color: rgba(245, 200, 118, 0.4); }
  .cart-form input:focus {
    border-color: var(--gold);
    background: rgba(0, 0, 0, 0.55);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 480px) {
    .menu-card img { height: 110px; }
    .product-img { height: 280px !important; }
  }

  /* ===== MOBILE: 3 KOLOM PRODUK, TAMPILAN MIRIP PC ===== */
  /* Semua layar < 768px: grid 3 kolom seperti desktop */
  @media (max-width: 767px) {
    /* Header: lebih kecil & proporsional untuk mobile */
    .header {
      padding: 6px 12px;
      min-height: 50px;
    }
    .header-rotator { min-height: 40px; }
    .header-rotator-logo  { width: 38px; height: 38px; }
    .header-rotator-brand { font-size: 16px; letter-spacing: 2.5px; }
    .header-rotator-subtitle { font-size: 10px; letter-spacing: 2px; }
    .header .header-cart-btn {
      font-size: 11px;
      padding: 5px 8px;
      gap: 4px;
      border-radius: 16px;
      margin-left: auto;
    }
    .header .header-cart-count { width: 17px; height: 17px; font-size: 9px; }
    .header .header-wifi-btn {
      font-size: 10px;
      padding: 6px 10px;
      gap: 0;
      border-radius: 50%;
      min-height: 34px;
      min-width: 34px;
    }
    .header .header-wifi-icon { font-size: 16px; }
    .header .header-wifi-label { display: none; }

    /* Tab kategori: muat di satu baris, lebih ramping */
    .kategori-tabs {
      padding: 8px 10px;
      top: 50px;
      gap: 6px;
    }
    .kategori-tabs .tabs-group {
      gap: 4px;
      padding: 1px;
      border-radius: 22px;
      background: rgba(0, 0, 0, 0.3);
      border: none;
      box-shadow: none;
    }
    .tab-btn {
      padding: 5px 10px;
      font-size: 11px;
      border-radius: 16px;
    }

    /* Search input: kecil & pas di mobile */
    .kategori-search {
      flex: 0 0 auto;
    }
    .kategori-search .search-icon {
      font-size: 13px;
      left: 10px;
    }
    .kategori-search .search-clear {
      width: 18px;
      height: 18px;
      font-size: 11px;
      right: 5px;
    }
    .kategori-search input {
      width: 110px;
      max-width: 28vw;
      padding: 7px 30px 7px 30px;
      font-size: 11px;
      border-radius: 18px;
    }
    .kategori-search input:focus {
      width: 140px;
    }

    /* GRID 3 KOLOM untuk menu produk */
    .menu-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      padding: 0 2px;
    }

    /* Kartu produk diperkecil proporsional */
    .menu-card { border-radius: 12px; min-height: 120px; }
    .menu-card img { height: 75px; }
    .menu-card-info { padding: 6px 4px; gap: 3px; }
    .menu-name { font-size: 10.5px; line-height: 1.15; }
    .menu-price { font-size: 10.5px; }
    .menu-add-btn {
      width: 24px;
      height: 24px;
      font-size: 12px;
      right: 4px;
      bottom: 4px;
    }

    /* Section spacing lebih rapat */
    .section { padding: 12px 6px 100px; }
    .section-title { font-size: 15px; }
  }

  /* iOS-safe-area: notch & home indicator */
  @media (max-width: 767px) {
    .header {
      padding-left: max(12px, env(safe-area-inset-left));
      padding-right: max(12px, env(safe-area-inset-right));
      padding-top: max(4px, env(safe-area-inset-top));
    }
    .cart-fab {
      bottom: calc(16px + env(safe-area-inset-bottom));
      right: calc(14px + env(safe-area-inset-right));
    }
    .product-detail-overlay, .modal-overlay {
      padding-top: env(safe-area-inset-top);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .product-detail-box, .modal-box {
      max-height: calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    }
  }

  /* Touch-friendly tap targets (mobile compact) */
  @media (hover: none) and (pointer: coarse) {
    .tab-btn { min-height: 32px; }
    .menu-add-btn { min-width: 32px; min-height: 32px; }
    .header .header-cart-btn { min-height: 32px; }
    .banner-arrow { min-width: 36px; min-height: 36px; }
  }

  /* Landscape mobile: lebih pendek modal */
  @media (max-height: 500px) and (orientation: landscape) {
    .product-detail-box { max-height: 95vh; }
    .product-img { height: 160px !important; }
    .header { min-height: 50px; }
    .kategori-tabs { top: 50px; }
  }

  /* ===== ANDROID / MOBILE PERFORMANCE OPTIMIZATION ===== */
  /* Remove heavy GPU effects and disable continuous animations on mobile */
  @media (max-width: 767px) {
    /* Hide floating particles & ambient orbs entirely */
    .bg-particles, .bg-ambient, .bg-texture, .bg-beans { display: none !important; }

    /* Disable continuous keyframe animations (shimmer, float, glow, pulse, ken burns) */
    body::before,
    .menu-card img, .banner-hero-title, .banner-hero-desc,
    .cart-fab, .brand-text, .section-title,
    .card-badge-icon, .menu-card, .banner-content,
    .banner-arrow, .cart-badge, .banner-dots span,
    .qty-num, .menu-add-btn, .toast {
      animation: none !important;
      transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease, transform 0.2s ease !important;
    }

    /* Shimmer effect: replace with static background */
    .menu-card img {
      animation: none !important;
      background: var(--bg-light) !important;
    }

    /* FAB: remove float + glow animations, simple shadow */
    .cart-fab {
      animation: none !important;
      box-shadow: 0 4px 14px rgba(245, 200, 118, 0.4) !important;
    }

    /* Banner hero: disable drift zoom + particles on mobile (GPU saver) */
    .banner-hero { animation: none !important; }
    .banner-slide-img { animation: none !important; transform: scale(1.05) !important; }
    .banner-particles { display: none !important; }
    .banner-progress { display: none !important; }
    .banner-hero::before, .banner-hero::after { width: 16px; height: 16px; }
    .banner-content-card::before { animation-duration: 8s; }
    .banner-cta { padding: 6px 12px; font-size: 11px; }

    /* Disable multi-layer box-shadows on hover (expensive composite) */
    .menu-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.4) !important; transform: translateY(-2px) !important; }
    .menu-card:hover img { transform: none !important; }
    .banner-content:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.4) !important; }

    /* Remove backdrop-blur on mobile (GPU-heavy, kills Android browsers) */
    .header, .kategori-tabs, .modal-overlay, .product-detail-overlay,
    .banner-content, .toast, .modal-box, .pd-close-btn {
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }

    /* Replace header blur with opaque solid background */
    .header {
      background: #2e1a0f !important;
    }
    .kategori-tabs {
      background: #2e1a0f !important;
    }

    /* Disable entrance animations on page load */
    .header, .banner-section, .section, .modal-overlay,
    .menu-card, .banner-content, .modal-box, .product-detail-box {
      animation: none !important;
    }

    /* Reduce modal shadow */
    .product-detail-box, .modal-box {
      box-shadow: 0 10px 40px rgba(0,0,0,0.5) !important;
      transition: opacity 0.25s ease !important;
    }

    /* Simplify hover scale effects */
    .menu-add-btn:hover { transform: scale(1.1) !important; }
    .header .header-cart-btn:hover { transform: none !important; }

    /* Disable complex badgePop and other one-shot animations */
    .badge-pop, .ding, .bump, .pop {
      animation: none !important;
    }

    /* Disable new FAB/CS animations on mobile */
    .cs-fab, .bundle-card, .info-card, .wifi-card, .about-card, .booking-card {
      animation: none !important;
    }
    .cs-fab {
      width: 48px !important;
      height: 48px !important;
      font-size: 22px !important;
      bottom: 92px !important;
      left: 14px !important;
    }
    .cs-fab-label { display: none !important; }
    .bundle-card, .menu-card { min-height: auto !important; }
    .bundle-info { padding: 8px 10px 10px !important; }
    .bundle-name { font-size: 12px !important; }
    .bundle-items { font-size: 10px !important; }
    .bundle-price { font-size: 12px !important; }
    .bundle-add-btn { padding: 5px 10px !important; font-size: 10px !important; }
    .info-card { padding: 14px !important; }
    .info-card-icon { width: 40px !important; height: 40px !important; font-size: 22px !important; }
    .wifi-card, .booking-card, .about-card { padding: 14px !important; border-radius: 14px !important; }
    .booking-grid-2 { gap: 8px !important; }
    .booking-card input, .booking-card select, .booking-card textarea { padding: 9px 11px !important; font-size: 12px !important; }
    .booking-submit-btn { padding: 11px !important; font-size: 13px !important; }

    /* ===== PRODUCT DETAIL MODAL: COMPACT MOBILE ===== */
    .product-detail-box {
      width: 95vw !important;
      max-height: 92vh !important;
      border-radius: 18px !important;
      box-shadow: 0 10px 40px rgba(0,0,0,0.5) !important;
    }
    .product-detail-img {
      height: 150px !important;
    }
    .product-detail-content {
      padding: 14px 14px 16px !important;
    }
    .product-detail-title {
      font-size: 17px !important;
      margin-bottom: 4px !important;
    }
    .product-detail-desc {
      font-size: 12px !important;
      margin-bottom: 10px !important;
      line-height: 1.45 !important;
    }
    .product-detail-price {
      font-size: 17px !important;
      margin-bottom: 12px !important;
      padding: 6px 10px !important;
    }
    .pd-variant-row {
      margin-bottom: 10px !important;
      font-size: 12px !important;
      gap: 5px !important;
    }
    .pd-variant-row label {
      padding: 6px 10px !important;
      border-radius: 9px !important;
      font-size: 11px !important;
      gap: 4px !important;
    }
    #pdSugar {
      margin-bottom: 10px !important;
    }
    .pd-section-label {
      font-size: 11px !important;
      margin-bottom: 6px !important;
    }
    .pd-section-label::before {
      height: 10px !important;
    }
    .pd-sugar-options {
      gap: 4px !important;
    }
    .pd-sugar-options label {
      min-width: 60px !important;
      padding: 6px 4px !important;
      border-radius: 8px !important;
      font-size: 11px !important;
      gap: 3px !important;
    }
    .pd-qty-row {
      padding: 7px 10px !important;
      gap: 6px !important;
      margin-bottom: 12px !important;
      border-radius: 10px !important;
    }
    .pd-qty-label {
      font-size: 12px !important;
    }
    .pd-qty-btn {
      width: 28px !important;
      height: 28px !important;
      font-size: 14px !important;
      border-radius: 8px !important;
    }
    .pd-qty-num {
      font-size: 14px !important;
      min-width: 20px !important;
    }
    .product-detail-actions {
      gap: 8px !important;
    }
    .product-detail-actions button {
      padding: 9px !important;
      border-radius: 10px !important;
      font-size: 12px !important;
    }
    .pd-close-btn {
      width: 28px !important;
      height: 28px !important;
      top: 8px !important;
      right: 8px !important;
      font-size: 12px !important;
    }

    /* ===== CART OVERLAY (PESANAN ANDA): COMPACT MOBILE ===== */
    .cart-overlay {
      width: 95vw !important;
      max-height: 92vh !important;
      border-radius: 18px !important;
      box-shadow: 0 10px 40px rgba(0,0,0,0.5) !important;
    }
    .cart-header {
      padding: 12px 16px 10px !important;
    }
    .cart-header-title {
      font-size: 16px !important;
      letter-spacing: 0.3px !important;
    }
    .cart-close-btn {
      width: 30px !important;
      height: 30px !important;
      font-size: 15px !important;
    }
    .cart-body {
      padding: 10px 14px !important;
    }
    .cart-empty {
      font-size: 13px !important;
      padding: 30px 0 !important;
    }
    .cart-item-row {
      padding: 10px 0 !important;
      gap: 8px !important;
    }
    .cart-item-name {
      font-size: 13px !important;
    }
    .cart-item-variant {
      font-size: 11px !important;
    }
    .cart-item-sub {
      font-size: 11px !important;
      margin-top: 3px !important;
    }
    .cart-sugar-tag {
      font-size: 10px !important;
      padding: 1px 5px !important;
    }
    .cart-remove-btn {
      font-size: 14px !important;
      padding: 3px 6px !important;
    }
    .cart-footer {
      padding: 12px 14px 18px !important;
    }
    .cart-total-row {
      font-size: 15px !important;
      padding: 9px 12px !important;
      margin-bottom: 10px !important;
      border-radius: 10px !important;
    }

    /* CART FORM (Detail Pemesan) — Compact */
    .cart-form {
      padding: 10px 10px !important;
      margin-bottom: 12px !important;
      border-radius: 12px !important;
    }
    .cart-form-title {
      font-size: 11px !important;
      margin-bottom: 8px !important;
      letter-spacing: 0.6px !important;
      gap: 6px !important;
    }
    .cart-form input {
      padding: 8px 10px !important;
      border-radius: 8px !important;
      font-size: 12px !important;
      margin-bottom: 6px !important;
    }
    .cart-form input:last-child {
      margin-bottom: 0 !important;
    }

    /* WhatsApp & clear cart buttons */
    .wa-order-btn {
      padding: 12px !important;
      border-radius: 12px !important;
      font-size: 13px !important;
      gap: 6px !important;
      letter-spacing: 0.3px !important;
    }
    .clear-cart-btn {
      padding: 9px !important;
      border-radius: 10px !important;
      font-size: 12px !important;
      margin-top: 7px !important;
    }
  }

  /* Product Detail Modal */
  .product-detail-overlay {
    position: fixed;
    inset: 0;
    z-index: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.7);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .product-detail-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }
  .product-detail-box {
    width: 340px;
    max-width: 92vw;
    max-height: 90vh;
    background: linear-gradient(180deg, rgba(93,54,33,0.98) 0%, rgba(46,26,15,0.98) 100%);
    border-radius: 22px;
    border: 1px solid rgba(245, 200, 118, 0.2);
    overflow: hidden;
    box-shadow: 0 25px 70px rgba(0,0,0,0.8), 0 0 30px rgba(245, 200, 118, 0.08);
    transform: scale(0.9);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .pd-close-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: all 0.2s;
  }
  .pd-close-btn:hover {
    background: rgba(217, 83, 79, 0.7);
    transform: scale(1.1);
  }
  .product-detail-overlay.open .product-detail-box {
    transform: scale(1);
  }
  .product-detail-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    flex-shrink: 0;
    transition: transform 0.4s var(--ease-smooth);
  }
  .product-detail-content {
    padding: 22px 22px 20px;
    overflow-y: auto;
  }
  .product-detail-title {
    font-size: 22px;
    font-weight: 800;
    color: var(--gold);
    margin-bottom: 8px;
    letter-spacing: 0.3px;
  }
  .product-detail-desc {
    font-size: 14px;
    color: rgba(245, 230, 211, 0.75);
    margin-bottom: 16px;
    line-height: 1.6;
  }
  .product-detail-price {
    font-size: 22px;
    font-weight: 800;
    color: var(--gold);
    margin-bottom: 18px;
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 10px;
    border-left: 3px solid var(--gold);
    display: inline-block;
  }
  .product-detail-actions {
    display: flex;
    gap: 10px;
  }
  .product-detail-actions button {
    flex: 1;
    padding: 11px;
    border-radius: 12px;
    border: none;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s var(--ease-spring);
  }
  .pda-cancel {
    background: rgba(245, 200, 118, 0.1);
    border: 1px solid rgba(245, 200, 118, 0.2);
    color: var(--gold);
  }
  .pda-cancel:hover {
    background: rgba(245, 200, 118, 0.18);
    transform: translateY(-1px);
  }
  .pda-add {
    background: linear-gradient(135deg, var(--gold), #b8860b);
    color: var(--bg-dark);
    box-shadow: 0 3px 14px rgba(245, 200, 118, 0.35);
  }
  .pda-add:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(245, 200, 118, 0.5);
  }

  /* Product Detail: variant radio & qty row */
  .pd-variant-row {
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pd-variant-row label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 12px;
    background: var(--bg-light);
    border: 1px solid rgba(245, 200, 118, 0.12);
    cursor: pointer;
    transition: all 0.25s var(--ease-smooth);
    color: var(--text);
  }
  .pd-variant-row label:hover {
    border-color: rgba(245, 200, 118, 0.35);
    background: rgba(245, 200, 118, 0.06);
  }
  .pd-variant-row input[type="radio"] {
    accent-color: var(--gold);
    cursor: pointer;
  }
  .pd-variant-row label:has(input:checked) {
    background: rgba(245, 200, 118, 0.12);
    border-color: var(--gold);
    color: var(--gold);
    box-shadow: 0 0 12px rgba(245, 200, 118, 0.15);
  }

  /* Sugar level (untuk minuman saja) */
  #pdSugar {
    display: none;
    margin-bottom: 14px;
  }
  .pd-section-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 8px;
    letter-spacing: 0.3px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .pd-section-label::before {
    content: '';
    width: 3px;
    height: 13px;
    background: var(--gold);
    border-radius: 2px;
  }
  .pd-sugar-options {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pd-sugar-options label {
    flex: 1;
    min-width: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 9px 8px;
    border-radius: 10px;
    background: var(--bg-light);
    border: 1px solid rgba(245, 200, 118, 0.15);
    cursor: pointer;
    transition: all 0.2s var(--ease-smooth);
    color: var(--text);
    font-size: 12px;
    font-weight: 600;
    text-align: center;
  }
  .pd-sugar-options label:hover {
    border-color: rgba(245, 200, 118, 0.4);
    background: rgba(245, 200, 118, 0.08);
  }
  .pd-sugar-options input[type="radio"] {
    accent-color: var(--gold);
    cursor: pointer;
    margin: 0;
  }
  .pd-sugar-options label:has(input:checked) {
    background: rgba(245, 200, 118, 0.15);
    border-color: var(--gold);
    color: var(--gold);
  }

  /* Sugar tag di keranjang */
  .cart-sugar-tag {
    display: inline-block;
    padding: 1px 7px;
    border-radius: 8px;
    background: rgba(245, 200, 118, 0.15);
    color: var(--gold);
    font-size: 11px;
    font-weight: 700;
    margin-left: 2px;
  }
  .pd-qty-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding: 10px 12px;
    background: var(--bg-light);
    border-radius: 12px;
    border: 1px solid rgba(245, 200, 118, 0.1);
  }
  .pd-qty-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-right: auto;
    letter-spacing: 0.3px;
  }
  .pd-qty-btn {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    border: 1px solid rgba(245, 200, 118, 0.2);
    background: rgba(0, 0, 0, 0.3);
    color: var(--gold);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s var(--ease-spring);
  }
  .pd-qty-btn:hover {
    background: rgba(245, 200, 118, 0.15);
    transform: scale(1.05);
  }
  .pd-qty-btn:active {
    transform: scale(0.92);
  }
  .pd-qty-num {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    min-width: 24px;
    text-align: center;
  }

  /* ===== BUNDLE CARD (Paket) ===== */
  .bundle-card {
    background: linear-gradient(180deg, rgba(245, 200, 118, 0.08) 0%, rgba(93,54,33,0.85) 100%);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.04);
    cursor: pointer;
    transition: all 0.4s var(--ease-spring);
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(245, 200, 118, 0.15);
    animation: fadeInUp 0.5s var(--ease-smooth) both;
  }
  .bundle-card:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 16px 40px rgba(0,0,0,0.6), 0 0 25px rgba(245, 200, 118, 0.18);
    border-color: rgba(245, 200, 118, 0.3);
  }
  .bundle-img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    background: var(--bg-light);
  }
  .bundle-info {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bundle-name {
    font-size: 14px;
    font-weight: 800;
    color: var(--gold);
    line-height: 1.3;
  }
  .bundle-items {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.5;
    background: rgba(0,0,0,0.25);
    padding: 6px 10px;
    border-radius: 8px;
    border-left: 2px solid var(--gold);
  }
  .bundle-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .bundle-price {
    font-size: 15px;
    color: var(--gold);
    font-weight: 800;
  }
  .bundle-price .original {
    font-size: 11px;
    color: var(--text-muted);
    text-decoration: line-through;
    font-weight: 500;
    margin-right: 6px;
  }
  .bundle-add-btn {
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    border: none;
    padding: 6px 14px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.25s var(--ease-spring);
    letter-spacing: 0.5px;
  }
  .bundle-add-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 14px rgba(245, 200, 118, 0.5);
  }
  .bundle-add-btn:active { transform: scale(0.95); }

  /* ===== WIFI PREMIUM SECTION ===== */
  .wifi-card {
    background: linear-gradient(135deg, rgba(46,26,15,0.9) 0%, rgba(74,44,26,0.85) 100%);
    border-radius: 18px;
    border: 1px solid rgba(245, 200, 118, 0.2);
    padding: 18px 20px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.4), inset 0 1px 0 rgba(245, 200, 118, 0.1);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .wifi-tier {
    background: rgba(0,0,0,0.3);
    border-radius: 14px;
    padding: 14px 16px;
    border: 1px solid rgba(245, 200, 118, 0.12);
    transition: all 0.3s var(--ease-smooth);
  }
  .wifi-tier:hover {
    border-color: rgba(245, 200, 118, 0.3);
    background: rgba(0,0,0,0.4);
  }
  .wifi-tier-name {
    font-size: 15px;
    font-weight: 800;
    color: var(--gold);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .wifi-tier-name::before {
    content: '📶';
    font-size: 16px;
  }
  .wifi-ssid, .wifi-pass {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'Consolas', monospace;
  }
  .wifi-ssid b, .wifi-pass b { color: var(--text); font-weight: 600; }
  .wifi-copy-btn {
    background: rgba(245, 200, 118, 0.15);
    border: 1px solid rgba(245, 200, 118, 0.25);
    color: var(--gold);
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 6px;
    cursor: pointer;
    margin-left: auto;
    transition: all 0.2s;
  }
  .wifi-copy-btn:hover { background: rgba(245, 200, 118, 0.25); }
  .wifi-price {
    margin-top: 8px;
    font-size: 13px;
    color: var(--gold);
    font-weight: 700;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .wifi-buy-btn {
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    border: none;
    padding: 6px 14px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.25s var(--ease-spring);
  }
  .wifi-buy-btn:hover { transform: scale(1.05); }

  /* ===== INFO CARD (Promo/Lokasi/Jam) ===== */
  .info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    padding: 0 6px;
    max-width: 750px;
    margin: 0 auto;
  }
  @media (min-width: 600px) {
    .info-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .info-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .info-card {
    background: linear-gradient(180deg, rgba(245, 200, 118, 0.05) 0%, rgba(93,54,33,0.85) 100%);
    border-radius: 16px;
    padding: 18px;
    border: 1px solid rgba(245, 200, 118, 0.12);
    box-shadow: 0 4px 18px rgba(0,0,0,0.35);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: all 0.3s var(--ease-smooth);
  }
  .info-card:hover {
    transform: translateY(-3px);
    border-color: rgba(245, 200, 118, 0.25);
    box-shadow: 0 10px 28px rgba(0,0,0,0.5), 0 0 20px rgba(245, 200, 118, 0.1);
  }
  .info-card-icon {
    font-size: 28px;
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, var(--gold), #e0b366);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(245, 200, 118, 0.4);
  }
  .info-card-title {
    font-size: 14px;
    font-weight: 800;
    color: var(--gold);
    margin: 0;
    letter-spacing: 0.3px;
  }
  .info-card-body {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .info-card-body b { color: var(--text); }
  .info-card-action {
    background: rgba(245, 200, 118, 0.15);
    border: 1px solid rgba(245, 200, 118, 0.25);
    color: var(--gold);
    padding: 7px 12px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s;
    display: inline-block;
  }
  .info-card-action:hover {
    background: rgba(245, 200, 118, 0.25);
    transform: translateY(-1px);
  }

  /* ===== ABOUT / VISI MISI ===== */
  .about-card {
    background: linear-gradient(180deg, rgba(245, 200, 118, 0.05) 0%, rgba(93,54,33,0.85) 100%);
    border-radius: 18px;
    padding: 20px;
    border: 1px solid rgba(245, 200, 118, 0.15);
    box-shadow: 0 6px 22px rgba(0,0,0,0.4);
    max-width: 750px;
    margin: 0 auto 16px;
  }
  .about-card h4 {
    font-size: 14px;
    font-weight: 800;
    color: var(--gold);
    margin: 0 0 8px;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .about-card h4::before {
    content: '';
    width: 3px;
    height: 14px;
    background: var(--gold);
    border-radius: 2px;
  }
  .about-card p {
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }
  .about-card p b { color: var(--text); }

  /* ===== BOOKING / RESERVATION ===== */
  .booking-card {
    background: linear-gradient(180deg, rgba(46,26,15,0.95) 0%, rgba(74,44,26,0.9) 100%);
    border-radius: 18px;
    padding: 20px;
    border: 1px solid rgba(245, 200, 118, 0.18);
    box-shadow: 0 8px 28px rgba(0,0,0,0.5);
    max-width: 750px;
    margin: 0 auto;
  }
  .booking-card input,
  .booking-card select,
  .booking-card textarea {
    width: 100%;
    padding: 11px 14px;
    border-radius: 10px;
    border: 1px solid rgba(245, 200, 118, 0.18);
    background: rgba(0, 0, 0, 0.4);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    outline: none;
    margin-bottom: 10px;
    box-sizing: border-box;
    font-family: inherit;
    transition: all 0.25s var(--ease-smooth);
  }
  .booking-card input::placeholder,
  .booking-card textarea::placeholder { color: rgba(245, 200, 118, 0.4); }
  .booking-card input:focus,
  .booking-card select:focus,
  .booking-card textarea:focus {
    border-color: var(--gold);
    background: rgba(0, 0, 0, 0.55);
  }
  .booking-card textarea { resize: vertical; min-height: 60px; }
  .booking-card label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 4px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .booking-submit-btn {
    width: 100%;
    background: linear-gradient(135deg, var(--gold), #e0b366);
    color: var(--bg-dark);
    border: none;
    padding: 13px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.25s var(--ease-spring);
    margin-top: 4px;
    letter-spacing: 0.4px;
  }
  .booking-submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(245, 200, 118, 0.5);
  }
  .booking-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  /* ===== CS (Customer Service) FLOATING BUTTON ===== */
  .cs-fab {
    position: fixed;
    bottom: 24px;
    left: 24px;
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: #fff;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    box-shadow: 0 8px 25px rgba(37,211,102,0.5), 0 0 30px rgba(37,211,102,0.15);
    cursor: pointer;
    z-index: 89;
    border: 3px solid rgba(255,255,255,0.15);
    transition: all 0.35s var(--ease-spring);
    text-decoration: none;
    animation: csFloat 3s ease-in-out infinite;
  }
  .cs-fab:hover {
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 14px 40px rgba(37,211,102,0.6), 0 0 50px rgba(37,211,102,0.25);
  }
  .cs-fab:active { transform: scale(0.92); }
  @keyframes csFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  .cs-fab-label {
    position: absolute;
    left: 64px;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(46,26,15,0.95);
    color: var(--gold);
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s, transform 0.3s;
    box-shadow: 0 4px 14px rgba(0,0,0,0.5);
    border: 1px solid rgba(245, 200, 118, 0.2);
  }
  .cs-fab:hover .cs-fab-label {
    opacity: 1;
    transform: translateY(-50%) translateX(4px);
  }

  /* ===== Sub-tabs for menu (Minuman / Bundle / Makanan) ===== */
  .kategori-tabs .tabs-group .tab-btn.tab-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
